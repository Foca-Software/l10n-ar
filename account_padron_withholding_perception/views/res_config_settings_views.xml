<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.l10n_ar_afip_ws</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="argentina_localization" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="check_census_on_create" class="oe_inline"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="check_census_on_create"/>
                        <div class="text-muted">
                            If it is activated, when creating a client or supplier, the system will look for withholding rates and perceptions for it.
                            Attention: the creation process can take several minutes.
                        </div>
                    </div>
                </div>
            </block>
        </field>
    </record>

    <record id="view_res_config_settings_arba_withholding_journal" model="ir.ui.view">
        <field name="name">res.config.settings.arba.withholding.journal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting string="ARBA Withholding Journal" help="Journal used to generate ARBA withholding payments automatically.">
                    <field name="arba_withholding_journal_id" domain="[('company_id','=',company_id)]"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

