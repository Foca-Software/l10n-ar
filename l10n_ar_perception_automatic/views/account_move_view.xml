<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_move_form_perception_automatic" model="ir.ui.view">
        <field name="name">account.move.form.perception.automatic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="calculate_perceptions"
                        type="object"
                        string="Calcular Percepciones"
                        class="btn-primary"
                        invisible="1"
                        help="Calcula y aplica automáticamente las percepciones correspondientes"/>
            </xpath>
        </field>
    </record>

</odoo>
